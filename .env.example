OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Account system: use a shared Postgres database and shared strong secret for both Agents.
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
# Set to this application origin; use its production HTTPS URL on Vercel.
BETTER_AUTH_URL=http://localhost:3000
# Server-only list of trusted administrator user IDs; never authorize by email alone.
ADMIN_USER_IDS=
AUTH_TRUSTED_ORIGINS=
